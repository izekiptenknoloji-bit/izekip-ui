#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041F04B0"
        BEGIN
            VALUE "CompanyName",      "İzekip Teknoloji"
            VALUE "FileDescription",  "İzekip UI SDK Kurulumu"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "IzekipUISetup"
            VALUE "LegalCopyright",   "Copyright (c) 2026 İzekip Team (MIT)"
            VALUE "OriginalFilename", "IzekipUISetup.exe"
            VALUE "ProductName",      "İzekip UI SDK"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x041F, 1200
    END
END
